# ---------- temel ----------
HOST=0.0.0.0
PORT=8080
HTTP_IMPERSONATE=chrome124
HTTP_TIMEOUT=15.0
HTTP_RETRIES=3
CACHE_TTL_STATUS=30
CACHE_TTL_MANIFEST=4
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://twitch.tv,https://www.twitch.tv,https://kick.com,https://www.kick.com,https://youtube.com,https://www.youtube.com
# Bos = yerlesik Twitch/Kick/YouTube CDN allowlist'i. Gerektikce daraltin.
HLS_ALLOWED_HOSTS=

# ---------- resmi API anahtarlari (hepsi opsiyonel) ----------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_ACCESS_TOKEN=

# ---------- v2: reklam filtresi ----------
AD_FILTER_ENABLED=true
AD_FILTER_STRATEGY=scte35        # none | scte35 | aggressive

# ---------- v2: bypass modulu (Not 3 alternatifi) ----------
BYPASS_BACKEND=direct            # direct | cf_server
CF_BYPASS_URL=http://localhost:8000
CF_BYPASS_MODE=mirror            # mirror | cookies
CF_COOKIE_TTL=1800
CF_PROTECTED_HOSTS=kick.com

# ---------- v2: twitch alternatifleri (Not 2) ----------
TWITCH_STREAM_SOURCE=direct      # direct | ttv_lol
TTV_LOL_PROXY=https://api.ttv.lol
TWITCH_INTEGRITY_MODE=auto       # off | auto | force
CHROMIUM_PATH=                   # bos = sistemden bul
INTEGRITY_TTL=43200
